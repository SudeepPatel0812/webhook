          "legendFormat": "{{route}}",
          "exemplar": true
        }
      ]
    },
    {
      "type": "row",
      "title": "Database",
      "collapsed": false,
      "id": 15,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 43
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Connection pool",
      "id": 101,
      "description": "Ingest, the poller, fan-out, the claim loop and delivery workers all share this pool. Pinned at max means queries are queueing.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 44
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "webhook_db_pool_connections_in_use",
          "legendFormat": "in use"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "webhook_db_pool_connections_max",
          "legendFormat": "max"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Waiting for a connection",
      "id": 102,
      "description": "How long a query waits for a free connection when none is available. This time is not in the query latency panels.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 44
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(webhook_db_pool_wait_seconds_total[$__rate_interval]) / clamp_min(rate(webhook_db_pool_waits_total[$__rate_interval]), 1e-9)",
          "legendFormat": "average wait"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Queries by name",

        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (route, code) (rate(webhook_http_requests_total{route!~\"/metrics|/health|/ready\"}[$__rate_interval]))",
          "legendFormat": "{{route}} {{code}}",
          "exemplar": false
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Latency p95 by route",
      "id": 14,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 35
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
